const q=document.getElementById("q");
const out=document.getElementById("out");
const opts=document.getElementById("opts");
const views=document.getElementById("views");
const chips=document.getElementById("chips");
let mode="all",view="table";

function norm(s){
 return String(s||"").replace(/\s+/g,"").toLowerCase();
}

function esc(s){
 return String(s||"").replace(/[&<>"]/g,c=>({
  "&":"&amp;",
  "<":"&lt;",
  ">":"&gt;",
  '"':"&quot;"
 }[c]));
}

function linkYear(y,type){
 const id=LK[String(y)+type];
 return id?'<a href="https://extmovie.com/movietalk/'+id+'" target="_blank" rel="noopener">'+y+'</a>':String(y);
}

function workList(year,type,index){
 const raw=(WORK[String(year)+type]||{})[index];
 if(!raw)return [];
 return Array.isArray(raw)?raw:[raw];
}

function decorate(year,type,index,name){
 if(!name)return "–";
 if(index<2||index===10&&type==="M")return esc(name);

 const works=workList(year,type,index);
 if(!works.length)return esc(name);

 const people=String(name).split("/");
 if(people.length>1&&works.length===people.length){
  return people.map((person,i)=>esc(person.trim())+" ("+esc(works[i])+")").join(" / ");
 }
 return esc(name)+" ("+works.map(esc).join(" / ")+")";
}

function tableHtml(keyword){
 let html="";

 [["M",1,ML,"영화"],["T",2,TL,"TV"]].forEach(m=>{
  if(mode!=="all"&&mode!==m[0])return;

  html+='<h3>'+m[3]+' 부문 전체 결과</h3><div class="tw"><table><thead><tr><th>연도</th>';

  m[2].forEach(label=>html+='<th>'+esc(label)+'</th>');

  html+='</tr></thead><tbody>';

  D.forEach(d=>{
   if(m[0]==="T"&&!d[2])return;

   const cells=d[m[1]].split("|");

   html+='<tr><td class="yearlink">'+linkYear(d[0],m[0])+'</td>';

   m[2].forEach((label,i)=>{
    const value=cells[i]||"";
    const shown=decorate(d[0],m[0],i,value);
    const hit=keyword&&(
     norm(value).includes(keyword)||
     workList(d[0],m[0],i).some(work=>norm(work).includes(keyword))
    );

    html+='<td'+(hit?' class="hit"':'')+'>'+shown+'</td>';
   });

   html+='</tr>';
  });

  html+='</tbody></table></div>';
 });

 return html;
}

function searchHtml(keyword){
 if(!keyword)return '<div class="none">검색어를 입력하거나 위의 이름을 눌러 보세요.</div>';

 let html="";
 let count=0;

 D.forEach(d=>{
  let rows="";

  [["M",d[1],ML],["T",d[2],TL]].forEach(s=>{
   if((mode!=="all"&&mode!==s[0])||!s[1])return;

   const cells=s[1].split("|");

   cells.forEach((value,i)=>{
    const works=workList(d[0],s[0],i);

    // 수상자 이름과 수상 작품을 각각 검색
    const nameMatch=value&&norm(value).includes(keyword);
    const workMatch=works.some(work=>norm(work).includes(keyword));

    if(nameMatch||workMatch){
     const result=decorate(d[0],s[0],i,value);

     rows+='<tr>'+
      '<td>'+s[0]+'</td>'+
      '<td>'+esc(s[2][i])+'</td>'+
      '<td>'+result+'</td>'+
      '</tr>';

     count++;
    }
   });
  });

  if(rows){
   html+='<h3>'+d[0]+'년</h3>'+
    '<div class="tw"><table>'+
    '<thead><tr><th>구분</th><th>부문</th><th>선정 결과</th></tr></thead>'+
    '<tbody>'+rows+'</tbody>'+
    '</table></div>';
  }
 });

 if(!count)return '<div class="none">검색 결과가 없어요.</div>';

 return '<p class="result-count">검색 결과 '+count+'건</p>'+html;
}

function multiHtml(keyword){
 let html="";

 D.forEach(d=>{
  [["M",d[1],ML],["T",d[2],TL]].forEach(s=>{
   if((mode!=="all"&&mode!==s[0])||!s[1])return;

   const cells=s[1].split("|");
   const rows=[];

   cells.forEach((v,i)=>{
    if(v.includes("/")&&(!keyword||norm(v).includes(keyword))){
     rows.push('<tr><td>'+esc(s[2][i])+'</td><td>'+decorate(d[0],s[0],i,v)+'</td></tr>');
    }
   });

   if(rows.length){
    html+='<h3>'+d[0]+'년 · '+(s[0]==="M"?"영화":"TV")+'</h3>'+
     '<div class="tw"><table>'+
     '<thead><tr><th>부문</th><th>공동 선정</th></tr></thead>'+
     '<tbody>'+rows.join("")+'</tbody>'+
     '</table></div>';
   }
  });
 });

 return html||'<div class="none">복수 선정 결과가 없어요.</div>';
}

function render(){
 const keyword=norm(q.value);

 Array.from(views.children).forEach(b=>{
  b.classList.toggle("on",b.dataset.v===view);
 });

 Array.from(opts.children).forEach(b=>{
  b.classList.toggle("on",b.dataset.m===mode);
 });

 if(view==="table"){
  out.innerHTML=tableHtml(keyword);
 }else if(view==="multi"){
  out.innerHTML=multiHtml(keyword);
 }else{
  out.innerHTML=searchHtml(keyword);
 }
}

views.addEventListener("click",e=>{
 const b=e.target.closest("button[data-v]");
 if(!b)return;

 view=b.dataset.v;
 render();
});

opts.addEventListener("click",e=>{
 const b=e.target.closest("button[data-m]");
 if(!b)return;

 mode=b.dataset.m;
 render();
});

chips.addEventListener("click",e=>{
 const b=e.target.closest("button");
 if(!b)return;

 q.value=b.textContent;
 view="search";
 render();
});

q.addEventListener("input",render);

render();
</script>

